# 백엔드는 아래 변수 중 하나를 DB 접속 URL로 사용합니다.
# 우선순위: SOBUN_DATABASE_URL > POSTGRES_URL > POSTGRES_PRISMA_URL > POSTGRES_URL_NON_POOLING
# 모두 없으면 로컬 SQLite(backend/sobunsobun.sqlite3)를 사용합니다.

# 직접 지정할 때 사용합니다.
SOBUN_DATABASE_URL="postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"

# Vercel/Supabase Integration에서 자동 주입되는 형식입니다.
POSTGRES_URL="postgres://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgres://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

POSTGRES_DATABASE="postgres"
POSTGRES_HOST="db.PROJECT_REF.supabase.co"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="PASSWORD"
