# Supabase API client settings.
# SQLAlchemy/Alembic DB 연결에는 아래 DB URL 변수가 필요합니다.
SUPABASE_URL=""
SUPABASE_KEY=""

# Backend DB connection.
# 우선순위: SOBUN_DATABASE_URL > POSTGRES_URL > POSTGRES_PRISMA_URL > POSTGRES_URL_NON_POOLING
# 모두 없으면 로컬 SQLite(backend/sobunsobun.sqlite3)를 사용합니다.
SOBUN_DATABASE_URL=""
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""
